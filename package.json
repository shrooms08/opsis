{
  "name": "opsis",
  "version": "0.1.0",
  "description": "Read-only command-line tool that explains what a Solana transaction did, with emphasis on why it failed",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "opsis": "./bin/opsis.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "solana",
    "transaction",
    "debugging",
    "cli"
  ],
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
